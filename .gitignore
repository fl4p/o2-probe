# Electronics (hw/) and firmware (hw/firmware/) carry their own .gitignore files.

# ---------------------------------------------------------------------------
# Mechanical half (cad/)
# ---------------------------------------------------------------------------

# Measured-mesh gate artifact: rebuilt by `make head-end-provisional`,
# and a half-MB ASCII duplicate of a tracked binary STL.
cad/exports/head-end-cavity-ascii.stl

# Sliced output. Machine- and material-specific (P1P 0.4 / ASA), several MB
# each, and regenerable from the plate 3mf; the plate is the tracked source.
cad/exports/*.gcode.3mf

# OpenSCAD's thumbnail-render failure log, dropped in the CWD by the 3mf export
# on a headless machine with no GL context ("Invalid OpenGL version 3.4"). Build
# detritus, regenerated every run, and nothing reads it.
00000.log
cad/exports/o2-probe-board.stl
cad/exports/o2-probe-board-bin.stl
cad/reviews/*.log
compostlab/o2-probe/reviews/*.log
reviews/*.log
cad/viewer/parts.json

# sliced plates: build output, and a plate_1.gcode is ~5 MB
cad/print/
cad/viewer/scene.json
cad/exports/view-*.stl

# ASCII intermediate weighed by tools/shell_volume.py. Same case as
# head-end-cavity-ascii.stl above: a duplicate of geometry we already have.
cad/exports/shell-gas-ascii.stl

# Build detritus: collar_drawing.py's scratch renders, and the head-end render log.
cad/exports/.collar-drawing/
cad/exports/.head.log

# Camera bridge runtime log.
cad/p1p-stream.log

# ---------------------------------------------------------------------------
# Both halves
# ---------------------------------------------------------------------------
__pycache__/
.DS_Store

# Playwright MCP scratch output -- page snapshots and console logs dropped in the
# CWD by any browser-using agent session. Megabytes, regenerated constantly, and
# nothing ever reads it back.
.playwright-mcp/

# Agent review runs: pid files, exit markers and multi-MB raw transcripts.
# Runtime, not evidence; a review that matters gets written up as a .md.
.review-runs/
reviews/codex-*/
cad/reviews/EXITED

# Editor/slicer backups and KiCad autosaves anywhere in the tree.
_autosave-*
*.bambu-bak

# Videos (print timelapses, bench recordings): too large for a public clone.
*.avi
*.mp4
*.mov
*.mkv
*.webm
*.m4v
