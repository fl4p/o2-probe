(footprint "Heater_Ring_Lands"
	(version 20240108)
	(generator "pcbnew")
	(layer "B.Cu")
	(descr "Two plain SMD lands at the front edge for the dry-side heated membrane carrier ring. No drills, no castellations, no plated slots: the ring is hand-soldered flat onto back copper. Both lands are pad number 1 - one HEATER_LOW node - so the ring is a heat spreader and never a conductor between them. They sit inside the HEATED_ISLAND_SPREADER pour, which is what connects them; no track is required.")
