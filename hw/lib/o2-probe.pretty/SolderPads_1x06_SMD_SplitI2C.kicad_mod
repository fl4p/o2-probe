(footprint "SolderPads_1x06_SMD_SplitI2C"
	(version 20240108)
	(generator "pcbnew")
	(layer "B.Cu")
	(descr "Six plain SMD solder lands for hand-soldered flying leads, 1.6 x 1.2 mm, no drills, no castellations, no paste. Four sit in a row on 2.6 mm pitch at the cable end (1=3V3D 2=GND 5=TX 6=RX); pads 3 (SDA) and 4 (SCL) are placed away from the row, clear of the analog front end. Pad 1 is marked on B.Fab.")
	(tags "solder pad lead expansion i2c uart smd")
	(attr smd exclude_from_pos_files)
	(duplicate_pad_numbers_are_jumpers no)
