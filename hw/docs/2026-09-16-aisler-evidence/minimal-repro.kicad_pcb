	(footprint "o2-probe:Heater_Ring_Lands"
		(layer "B.Cu")
		(uuid "d1a87d16-df47-4d34-9919-b4dcd6c4910e")
		(at 110 137.65)
		(descr "Two ring lands at the front edge for the dry-side heated membrane carrier ring, each present on FRONT AND BACK copper. Plain SMD rectangles - no drills, no castellations, no plated slots. All four pads are number 1: one HEATER_LOW node, so the ring is a heat spreader and never a conductor. The back lands sit in the HEATED_ISLAND_SPREADER pour; a via at each land ties the front land down to it.")
		(tags "heater ring hand solder membrane smd land")
		(property "Reference" "J5"
			(at 0 2.9 0)
			(layer "B.Fab")
			(hide yes)
			(uuid "b048fb52-ff58-4b39-9df4-a489d8c44d38")
