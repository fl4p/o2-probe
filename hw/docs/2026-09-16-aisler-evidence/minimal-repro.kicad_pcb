		)
		(property "Datasheet" ""
			(at 0 0 0)
			(layer "F.Fab")
			(hide yes)
			(uuid "d56f084c-300f-4b52-84d9-cdfb76b2d4d5")
			(effects
				(font
					(size 1.27 1.27)
				)
			)
		)
		(property "Description" ""
			(at 0 0 0)
			(layer "F.Fab")
			(hide yes)
			(uuid "e8bef7ab-e55b-4014-8754-efef84253498")
			(effects
				(font
					(size 1.27 1.27)
				)
			)
		)
		(property "Design Note" "Manual-soldered dry-side metal membrane-carrier ring. TWO RING LANDS at the front edge, each present on FRONT AND BACK copper (Fab, 2026-09-13), 2.8 x 2.0 mm - no drills, no plated slots, no castellations: the ring is soldered flat, so none of that tooling bought anything. All four pads are number 1, i.e. ONE HEATER_LOW node, so the ring is a heat spreader and never a conductor. The back lands sit inside the HEATED_ISLAND_SPREADER pour, which is what connects them - no track is required, and one added in its place connected nothing; a via at each land ties the front land down to that pour. Width is 2x the first attempt; HEIGHT IS CAPPED AT 2.0 by /I2C_SDA reaching Y 136.45 under the left land, not by choice."
			(at 0 5.3 0)
			(layer "B.Fab")
			(hide yes)
			(uuid "d1a839d0-923d-43a7-ad1a-8ceeaea7389f")
			(effects
				(font
					(size 0.8 0.8)
					(thickness 0.12)
				)
				(justify mirror)
			)
		)
