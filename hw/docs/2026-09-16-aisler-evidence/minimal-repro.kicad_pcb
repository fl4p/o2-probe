		(property "MPN" "REF3425IDBVR"
			(at 0 0 180)
			(layer "F.SilkS")
			(hide yes)
			(uuid "f367d2e7-f0cc-43d8-98ec-d863ca09ba4a")
			(effects
				(font
					(size 1.27 1.27)
					(thickness 0.15)
				)
				(justify mirror)
			)
		)
		(property "Design Note" "2.500 V series reference, REPLACING the AZ431 shunt and its R41/C9/R31 network. SBAS804G: +/-0.05% initial accuracy (max), 6 ppm/C max by the BOX method over -40..125 C -- which permits 990 ppm of TOTAL SPAN, not a 6 ppm/C local slope, so the bias contribution is ~0.9 mV and NOT the 0.3 mV a naive reading gives. 95 uA max Iq against the AZ431 network's 2.5 mA. Output +/-10 mA against this board's ~400 uA analog draw. IT IS NOT A 3-TERMINAL PART: pins are 1 GND_F, 2 GND_S, 3 EN, 4 IN, 5 OUT_S, 6 OUT_F and force/sense must BOTH be connected. EN IS TIED TO IN ON PURPOSE. Do not route it to a GPIO to make the rail gateable -- POWER-BUDGET.md invites exactly that, and dropping this rail drops the cell bias and restarts O2P_SETTLE_SECONDS = 900. Input is 3V3D and NOT +12V_SW: the board input is specified to 15 V and REF34's recommended input maximum is 12 V"
			(at 0 0 180)
			(layer "F.SilkS")
			(hide yes)
			(uuid "fc5341f4-65e7-4869-b43e-cefa05dfdd8c")
			(effects
				(font
					(size 1.27 1.27)
					(thickness 0.15)
				)
				(justify mirror)
			)
		)
