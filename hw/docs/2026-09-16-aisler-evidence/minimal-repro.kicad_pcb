	(footprint "o2-probe:SolderPads_1x04_SMD_PwrUart"
		(layer "B.Cu")
		(uuid "1860a879-d3af-43f9-855b-7f98be254530")
		(at 110 61.5)
		(descr "Four plain SMD solder lands in a row on 2.6 mm pitch for hand-soldered flying leads, 1.6 x 1.2 mm, no drills, no castellations, no paste (1=3V3D 2=GND 5=TX 6=RX). The I2C pair that used to sit between them is now J108 and J109. Pad 1 is marked on B.Fab.")
		(tags "solder pad lead expansion uart smd")
		(property "Reference" "J107"
			(at 0 2.6 0)
			(layer "B.Fab")
			(hide yes)
			(uuid "e8e7b6a8-aa11-49dd-8de9-dcd19a7754af")
			(effects
				(font
					(size 0.8 0.8)
					(thickness 0.12)
				)
				(justify mirror)
			)
		)
		(property "Value" "EXT SENSOR / UART PADS"
			(at 0 3.8 0)
			(layer "B.Fab")
			(hide yes)
			(uuid "0d9d83c1-9523-47d7-81cf-467414d30bfd")
			(effects
				(font
					(size 0.8 0.8)
					(thickness 0.12)
				)
				(justify mirror)
			)
		)
		(property "Datasheet" ""
			(at 0 0 0)
			(layer "F.Fab")
			(hide yes)
			(uuid "0e8beb25-6c81-4238-a0b6-3be9402d5c50")
			(effects
				(font
					(size 1.27 1.27)
				)
			)
		)
		(property "Description" ""
			(at 0 0 0)
			(layer "F.Fab")
			(hide yes)
			(uuid "60d137fa-ccfb-4f14-88b3-36c78b197077")
			(effects
				(font
					(size 1.27 1.27)
				)
			)
		)
		(property "Design Note" "Hand-solder lands, back copper, in a row at the cable end: 1=3V3D 2=GND 5=UART2_TX 6=UART2_RX. The I2C pair is NOT here - SDA is J108 and SCL is J109, separate single lands placed up the board clear of the analog front end. A lead for an external TMP117 therefore lands power at the cable end and I2C mid-board. Strap its ADD0 to SDA (0x4A) or SCL (0x4B) - NOT GND, which is 0x48 and collides with the LMP91000. No pull-ups on the lead; R10/R11 already bias the bus. 3.3 V logic only. Pads 5/6 duplicate J105/J106."
			(at 0 5 0)
			(layer "B.Fab")
			(hide yes)
			(uuid "aa000000-0000-4000-8000-00000000d001")
			(effects
				(font
					(size 0.8 0.8)
					(thickness 0.12)
				)
				(justify mirror)
			)
		)
