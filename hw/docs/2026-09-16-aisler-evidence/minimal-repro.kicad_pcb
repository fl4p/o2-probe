		(property "KiLib_Generator" "SMD_2terminal_chip_molded"
			(at 0 0 0)
			(layer "B.SilkS")
			(hide yes)
			(uuid "19a19f41-82b9-433e-8e74-35097daa463f")
			(effects
				(font
					(size 1 1)
					(thickness 0.15)
				)
				(justify mirror)
			)
		)
		(property "Design Note" "Local decoupling AT MCU VREF+ pin 5, which since 2026-09-12 is driven from /VREF_TRIM and not 3V3D. It FOLLOWED THE PIN rather than staying on 3V3D: its only reason to exist was that pin, and with pin 5 moved its bulk would otherwise be C10, 4.7 uF at U15 on the far side of the board. DS12232 Table 63 note 4 asks for a 100 nF specifically to cut high-frequency noise at this pin. 100n not 1u because the bulk is already at C10 and the total load on the REF3425 must stay inside SBAS804G's 0.1..10 uF stable range: 4.7 + 0.1 = 4.8 uF. 3V3D loses nothing -- C12, C13, C14, C11, C3, C20 and C21 are all still on it"
			(at 0 0 0)
			(layer "B.SilkS")
			(hide yes)
