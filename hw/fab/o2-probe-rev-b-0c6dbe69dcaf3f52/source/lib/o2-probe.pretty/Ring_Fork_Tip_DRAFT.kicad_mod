(footprint "Ring_Fork_Tip_DRAFT"
	(version 20240108)
	(generator "pcbnew")
	(layer "F.Cu")
	(descr "DRAFT solder lands at the two fork-finger tips for the perpendicular heater ring PCB. Finger centres at +/-7.8 mm sit mid-annulus between the measured cell can (r 7.31) and the derived neck bore (r 8.31). PAD WIDTH IS NOT FROZEN: RING-PCB.md section 5.1 requires the printed ASA neck bore to be measured on a real part before the 0.6 mm finger width and its 0.20 mm per-side clearance are committed. Front and back lands share a pad number so both layers of a finger are one conductor.")
	(tags "fork tip ring pcb heater t-joint hand solder draft")
	(property "Reference" "J5"
		(at 0 -2.6 0)
		(layer "F.Fab")
		(effects (font (size 0.8 0.8) (thickness 0.12)))
