			(effects
				(font
					(size 1 1)
					(thickness 0.15)
				)
			)
		)
		(property "Design Note" "Place directly at U3 IN/GND; include DC-bias derating in effective capacitance. Now the SAME PART as C1 (10u 25V X7R 1206). Was 10u 10V X7R 0805 -- the dielectric is carried explicitly on BOTH so the consolidation cannot silently drop it. Was also the only 0805 capacitor on the board, so C_0805_2012Metric leaves with it. Raising 10V to 25V on a 5V rail is a strict improvement in DC-bias derating, not the voltage-rating collapse the 100n audit below forbids -- that rule guards against buying a HIGH-rated position to a LOW-rated line"
			(at 0 0 90)
			(layer "F.SilkS")
			(hide yes)
			(uuid "3b0a9618-f841-5d17-9a66-b57f785a849e")
			(effects
				(font
					(size 1.27 1.27)
					(thickness 0.15)
				)
			)
		)
