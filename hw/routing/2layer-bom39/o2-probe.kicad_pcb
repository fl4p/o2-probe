				)
				(justify mirror)
			)
		)
		(property "Design Note" "Isolates C10's bulk capacitance from the AZ431 cathode, which is what keeps the shunt out of its unstable band (see C9). It was originally the OPA2333's capacitive-load isolation and happens to be exactly right here -- note it would have been WRONG for a series reference like the REF33xx, which requires 0.1-10 uF ON its output pin. The 26.9 uA drawn by R34/R35 across 47R is a 1.25 mV offset that does not matter: it lands on VREF_TRIM, which is BOTH the LMP91000 bias reference and the ADS1119 external reference, so it cancels ratiometrically. Net name VREF_TRIM is retained despite there no longer being a trimmer -- firmware/src/lmp91000.h and firmware/tools/gen_hw_contract.py key off it"
			(at 0 0 90)
			(layer "B.SilkS")
			(hide yes)
			(uuid "91907cd2-c2b6-5530-bbfd-d26ff084a3ba")
			(effects
				(font
					(size 1.27 1.27)
					(thickness 0.15)
				)
				(justify mirror)
			)
		)
