firmware/platformio.ini-27-board = o2probe_g071cb
firmware/platformio.ini-28-framework = stm32cube
firmware/platformio.ini-29-board_build.ldscript = ldscript/o2probe_app.ld
firmware/platformio.ini-30-; The slot, not the part: a build that outgrows 52 KiB must fail here rather
firmware/platformio.ini-31-; than link over the staging slot.
firmware/platformio.ini-32-board_upload.maximum_size = 53248
firmware/platformio.ini-33-
firmware/platformio.ini-34-; Regenerate-and-compare the hardware contract before every build. gen_sch.py is
firmware/platformio.ini:35:; the schematic source of truth; if a divider or a pin moved under us, fail here
firmware/platformio.ini-36-; rather than silently reporting rescaled telemetry. See tools/gen_hw_contract.py.
firmware/platformio.ini-37-extra_scripts =
firmware/platformio.ini-38-	pre:tools/pio_hw_contract.py
firmware/platformio.ini-39-	post:tools/pio_image_check.py
firmware/platformio.ini-40-
firmware/platformio.ini-41-build_flags =
firmware/platformio.ini-42-	-std=gnu11
firmware/platformio.ini-43-	-Os
--
firmware/platformio.ini-211-build_unflags = ${env:o2probe.build_unflags} -DO2P_HEATER_ENABLE=0
firmware/platformio.ini-212-build_flags = ${env:o2probe.build_flags} -DO2P_HEATER_ENABLE=1
firmware/platformio.ini-213-build_src_flags = ${env:o2probe.build_src_flags}
firmware/platformio.ini-214-build_src_filter = ${env:o2probe.build_src_filter}
firmware/platformio.ini-215-
firmware/platformio.ini-216-; ---------------------------------------------------------------------------
firmware/platformio.ini-217-; BENCH ONLY - NEVER DEPLOY, NEVER POT A PROBE RUNNING THIS.
firmware/platformio.ini-218-;
firmware/platformio.ini:219:; The first article's ADS1119 has two dead analog inputs, AIN1 (VREF monitor)
firmware/platformio.ini:220:; and AIN3 (VIN monitor); a replacement part is on order. Both are diagnostic
firmware/platformio.ini:221:; channels - AIN0, the oxygen measurement, is unaffected - so this build lets
firmware/platformio.ini-222-; the cell work proceed by substituting a MANUALLY MEASURED reference for the
firmware/platformio.ini-223-; one firmware can no longer read.
firmware/platformio.ini-224-;
firmware/platformio.ini-225-; O2P_BENCH_VREF_MV is the DMM reading at TP4, in millivolts. Re-measure and
firmware/platformio.ini-226-; update it after ANY trim of RV1: firmware can no longer catch a drift, and
firmware/platformio.ini-227-; the -600 mV cell bias is 24 % of this number. main.c rejects values outside
firmware/platformio.ini-228-; 2400..2600 at compile time.
firmware/platformio.ini-229-;
firmware/platformio.ini-230-; VIN is published as the invalid sentinel here rather than the fabricated
firmware/platformio.ini:231:; value AIN3 mirrors from AIN0. Watch the supply on the PSU instead.
firmware/platformio.ini-232-; ---------------------------------------------------------------------------
firmware/platformio.ini-233-[env:o2probe_bench]
firmware/platformio.ini-234-platform = ${env:o2probe.platform}
firmware/platformio.ini-235-board = ${env:o2probe.board}
firmware/platformio.ini-236-framework = ${env:o2probe.framework}
firmware/platformio.ini-237-board_build.ldscript = ${env:o2probe.board_build.ldscript}
firmware/platformio.ini-238-board_upload.maximum_size = ${env:o2probe.board_upload.maximum_size}
firmware/platformio.ini-239-extra_scripts = ${env:o2probe.extra_scripts}
--
