firmware/tools/gen_hw_contract.py:166:    a("/* ---- Cell bias telemetry (ADS1119 AIN2/AIN3, differential) ---- */")
firmware/tools/gen_hw_contract.py-167-    a("/* The LMP91000's internal bias step carries a +/-2 % of VREF tolerance,")
firmware/tools/gen_hw_contract.py-168-    a(" * about +/-50 mV against a +/-10 mV cell window. It is no longer trimmed")
firmware/tools/gen_hw_contract.py-169-    a(" * out; it is MEASURED as V_WE - V_RE through the U4 followers and reported,")
firmware/tools/gen_hw_contract.py-170-    a(" * and an in-situ gas calibration absorbs it on the diffusion-limited")
firmware/tools/gen_hw_contract.py:171:    a(" * plateau. Read AIN2-AIN3 differentially. */")
firmware/tools/gen_hw_contract.py-172-    a("#define O2P_HW_BIAS_ADC_CH_WE  2")
firmware/tools/gen_hw_contract.py-173-    a("#define O2P_HW_BIAS_ADC_CH_RE  3")
firmware/tools/gen_hw_contract.py-174-    a("")
firmware/tools/gen_hw_contract.py-175-    a("/* ---- VREF: U15 AZ431B 2.5 V shunt reference, NOT adjustable ---- */")
firmware/tools/gen_hw_contract.py-176-    a("/* There is no trimmer. Firmware verifies the reference is within its own")
firmware/tools/gen_hw_contract.py-177-    a(" * guaranteed window and reports the measured cell bias separately; it can")
firmware/tools/gen_hw_contract.py-178-    a(" * neither set VREF nor correct the bias by moving it. */")
firmware/tools/gen_hw_contract.py-179-    a(f"#define O2P_HW_VREF_MIN_MV     {vref_min_mv:.0f}")
