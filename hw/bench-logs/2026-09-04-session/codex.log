firmware/src/lmp91000.h-31-enum {
firmware/src/lmp91000.h-32-    O2P_LMP_REG_STATUS = 0x00u,  /* bit0: 1 = ready */
firmware/src/lmp91000.h-33-    O2P_LMP_REG_LOCK   = 0x01u,  /* bit0: 0 = TIACN/REFCN writable, 1 = locked */
firmware/src/lmp91000.h-34-    O2P_LMP_REG_TIACN  = 0x10u,
firmware/src/lmp91000.h-35-    O2P_LMP_REG_REFCN  = 0x11u,
firmware/src/lmp91000.h-36-    O2P_LMP_REG_MODECN = 0x12u,
firmware/src/lmp91000.h-37-};
firmware/src/lmp91000.h-38-
firmware/src/lmp91000.h:39:/* TIACN = TIA_GAIN[4:2] | RLOAD[1:0].
firmware/src/lmp91000.h:40: *   TIA_GAIN 011 = 7 kOhm. PLAN.md:254 sizes the chain for >=150 uA: the cell
firmware/src/lmp91000.h-41- *   reaches ~152 uA at 30 % O2, which across 7 kOhm is a 1.06 V excursion from
firmware/src/lmp91000.h-42- *   the 1.675 V internal zero - inside the 0-3.3 V output range. 14 kOhm would
firmware/src/lmp91000.h-43- *   clip; 3.5 kOhm would waste half the ADC.
firmware/src/lmp91000.h-44- *   RLOAD 00 = 10 Ohm, the smallest offered, because the load resistor sits in
firmware/src/lmp91000.h-45- *   series with the working electrode and only adds error here.
firmware/src/lmp91000.h-46- */
firmware/src/lmp91000.h-47-#define O2P_LMP_TIACN_INTENDED  ((uint8_t)((3u << 2) | 0u))   /* 0x0C */
firmware/src/lmp91000.h-48-
firmware/src/lmp91000.h-49-/* REFCN = REF_SOURCE[7] | INT_Z[6:5] | BIAS_SIGN[4] | BIAS[3:0].
firmware/src/lmp91000.h:50: *   REF_SOURCE 1 = external: the trimmed 2.500 V on VREF_TRIM, shared with the
firmware/src/lmp91000.h:51: *   ADS1119's REFP so the measurement is ratiometric.
firmware/src/lmp91000.h-52- *   INT_Z 10 = 67 %. The cell current is unipolar, so putting the zero high
firmware/src/lmp91000.h-53- *   gives the whole downward swing to signal.
firmware/src/lmp91000.h-54- *   BIAS_SIGN 0 = negative, i.e. (VWE - VRE) < 0, which is what the SGX cell
firmware/src/lmp91000.h-55- *   specifies. NOTE: SCHEMATIC-REVIEW.md M4 leaves the SGX SIGN CONVENTION as
firmware/src/lmp91000.h-56- *   an open release gate - this encodes the datasheet reading, and the bench
firmware/src/lmp91000.h-57- *   air-versus-nitrogen pair is what confirms it.
firmware/src/lmp91000.h-58- *   BIAS 1101 = 24 %, the maximum step.
firmware/src/lmp91000.h-59- */
