53-    53	    }
54:    54	    if (!wr(O2P_LMP_REG_REFCN, O2P_LMP_REFCN_INTENDED)) {
55-    55	        return O2P_LMP_IO;
56-    56	    }
57:    57	    /* MODECN is not lock-protected. Written last: it is what takes the part
58:    58	     * out of deep sleep, so the bias network is already configured when the
59-    59	     * cell is first driven. Writing it first would briefly bias the cell with
60-    60	     * the reset-default 50 % internal zero and 0 % bias. */
61:    61	    if (!wr(O2P_LMP_REG_MODECN, O2P_LMP_MODECN_INTENDED)) {
62-    62	        return O2P_LMP_IO;
63-    63	    }
64-    64	    return o2p_lmp91000_verify(NULL);
65-    65	}
66-    66	
67:    67	o2p_lmp_status_t o2p_lmp91000_verify(uint16_t *out_readback)
68-    68	{
69-    69	    uint8_t tiacn = 0u, refcn = 0u, modecn = 0u;
70:    70	    if (!rd(O2P_LMP_REG_TIACN, &tiacn) ||
71:    71	        !rd(O2P_LMP_REG_REFCN, &refcn) ||
72:    72	        !rd(O2P_LMP_REG_MODECN, &modecn)) {
73-    73	        return O2P_LMP_IO;
74-    74	    }
75:    75	    if (out_readback != NULL) {
76:    76	        *out_readback = (uint16_t)(((uint16_t)tiacn << 8) | refcn);
77-    77	    }
78:    78	    /* TIACN bits 7:5 are RESERVED and are not guaranteed to read back as
79-    79	     * written, so compare only the defined fields. Comparing the whole byte
80-    80	     * would produce a permanent false mismatch, which is worse than no check:
81-    81	     * it would hold the probe in SETTLING forever. */
82:    82	    if ((uint8_t)(tiacn & 0x1Fu) != O2P_LMP_TIACN_INTENDED) {
83-    83	        return O2P_LMP_MISMATCH;
84-    84	    }
85:    85	    if (refcn != O2P_LMP_REFCN_INTENDED) {
86-    86	        return O2P_LMP_MISMATCH;
87-    87	    }
88:    88	    /* MODECN bits 6:3 are reserved; OP_MODE and FET_SHORT are what matter. */
89:    89	    if ((uint8_t)(modecn & 0x87u) != O2P_LMP_MODECN_INTENDED) {
90-    90	        return O2P_LMP_MISMATCH;
91-    91	    }
92-    92	    return O2P_LMP_OK;
93-    93	}

