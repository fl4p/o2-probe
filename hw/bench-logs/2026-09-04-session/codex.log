141-   141	o2p_ads_status_t o2p_ads1119_average(uint8_t mux, uint8_t dr, bool ext_ref,
142-   142	                                     unsigned n, int32_t *out_code)
143-   143	{
144-   144	    if (out_code == NULL || n == 0u || n > 64u) {
145-   145	        return O2P_ADS_IO;
146-   146	    }
147-   147	    int32_t acc = 0;
148-   148	    for (unsigned i = 0; i < n; i++) {
149-   149	        int16_t c = 0;
150-   150	        o2p_ads_status_t st = o2p_ads1119_convert(mux, dr, ext_ref, &c);
151-   151	        if (st != O2P_ADS_OK) {
152-   152	            /* Do not average what we have. Half a sample set taken before a
153-   153	             * device died is not a lower-confidence reading, it is a reading
154-   154	             * of an unknown interval. */
155-   155	            return st;
156-   156	        }
157-   157	        acc += c;
158-   158	    }
159-   159	    *out_code = acc / (int32_t)n;
160-   160	    return O2P_ADS_OK;
161-   161	}
162-   162	
163:   163	int32_t o2p_ads1119_code_to_uv(int32_t code, uint32_t vref_mv)
164-   164	{
165-   165	    /* FSR = +/-VREF at gain 1, and full scale is 2^15 codes (SBAS925A 8.4.5:
166-   166	     * 1 LSB = 2*VREF/2^16 = +FS/2^15). With VREF = 2500 mV that is 76.29 uV
167-   167	     * per code. Done in int64 so the intermediate cannot overflow: 32767 *
168-   168	     * 2500000 exceeds int32. */
169-   169	    int64_t uv = ((int64_t)code * (int64_t)vref_mv * 1000) / 32768;
170-   170	    return (int32_t)uv;
171-   171	}

