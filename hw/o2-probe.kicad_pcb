		(property "KiLib_Generator" "SMD_2terminal_chip_molded"
			(at 0 0 90)
			(layer "B.SilkS")
			(hide yes)
			(uuid "d4174095-05f2-4707-bc12-8272962bfab5")
			(effects
				(font
