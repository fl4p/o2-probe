	(footprint "o2-probe:Ring_Fork_Tip_DRAFT"
		(layer "F.Cu")
		(uuid "152b5ee8-7a41-4649-b0b3-6f66b0da933f")
		(at 110 155.5)
		(descr "DRAFT solder lands at the two fork-finger tips for the perpendicular heater ring PCB. Finger centres at +/-7.8 mm sit mid-annulus between the measured cell can (r 7.31) and the derived neck bore (r 8.31). PAD WIDTH IS NOT FROZEN: RING-PCB.md section 5.1 requires the printed ASA neck bore to be measured on a real part before the 0.6 mm finger width and its 0.20 mm per-side clearance are committed. Front and back lands share a pad number so both layers of a finger are one conductor.")
		(tags "fork tip ring pcb heater t-joint hand solder draft")
		(property "Reference" "J5"
			(at 0 -2.6 0)
			(layer "F.Fab")
			(hide yes)
			(uuid "6cd13707-e47f-44f6-9c4c-321ebc1a0c4f")
			(effects
				(font
					(size 0.8 0.8)
					(thickness 0.12)
				)
			)
		)
		(property "Value" "RING PCB FORK TIP"
			(at 0 2.6 0)
			(layer "F.Fab")
			(hide yes)
			(uuid "577df47a-591b-4365-a782-35ded0a21700")
			(effects
				(font
					(size 0.8 0.8)
					(thickness 0.12)
				)
			)
		)
		(property "Datasheet" ""
			(at 0 0 0)
			(layer "F.Fab")
			(hide yes)
			(uuid "7fbe0d04-ea82-4d22-be60-5f61662580be")
			(effects
				(font
					(size 1.27 1.27)
				)
			)
		)
		(property "Description" ""
			(at 0 0 0)
			(layer "F.Fab")
			(hide yes)
			(uuid "eceb9fc9-f8fb-4be8-be1c-2f96f8cf9476")
			(effects
				(font
					(size 1.27 1.27)
				)
			)
		)
		(property "Design Note" "Solder lands at the tips of the two fork fingers, carrying the heater pair forward to a perpendicular ring PCB (a soldered T-joint, the way any right-angle daughterboard mounts). REPLACES the two edge castellations of Heater_Ring_Solder_Lands, which HEATED-SPREADER.md section 0 showed are orphaned by the end-window head. One finger per net, both layers of each finger paralleled. RING-PCB.md section 1 offered 4 conductors; only 2 are used, because Fab dropped the ring's temperature sensor from this revision -- the second layer of each finger stays physically free, so a v2 ring can add one with NO main-board change. FOOTPRINT IS DRAFT: RING-PCB.md section 5.1 forbids freezing the 0.6 mm finger width before the printed ASA neck bore is measured on a real part"
			(at 0 0 0)
			(layer "F.SilkS")
			(hide yes)
			(uuid "ade999f2-298d-4080-b217-030086b3baae")
			(effects
				(font
					(size 1.27 1.27)
					(thickness 0.15)
				)
			)
		)
