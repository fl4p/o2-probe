			(uuid "5380e3a6-9cc5-4daa-b083-62fe25a3ccff")
			(effects
				(font
					(size 1.27 1.27)
					(thickness 0.15)
				)
			)
		)
		(property "Design Note" "Q1 VGS clamp, K to the PMOS source; 10V SOD-123. Was a 12V BZT52C12, whose GUARANTEED max VZ of 12.7 V at 5 mA (DS18004) exceeds the DMP3130L +/-12 V VGSS absolute maximum -- the old part never bounded VGS. Vishay doc 86342 gives BZT52C10 as 9.50/10/10.50 V at IZT 5 mA with aVZ +5..+8 mV/C. VZ rises with current, so VZ(30 uA) <= VZ(5 mA) <= 10.50 V; at +85 C the bound is 10.50 + 0.008*60 = 10.98 V, inside 12 V with ~1.0 V margin. Cold end: 9.50 - 0.52 = 8.98 V, still far above Q1 threshold. Clamp dissipation at 15 V in is (15-10.5)/100k = 45 uA, 0.5 mW in a 410 mW part"
			(at 0 0 90)
			(layer "F.SilkS")
			(hide yes)
			(uuid "4e76fcb2-5dcc-428d-a855-6102af0ed1f1")
			(effects
				(font
					(size 1.27 1.27)
					(thickness 0.15)
				)
			)
		)
