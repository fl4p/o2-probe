				)
				(justify mirror)
			)
		)
		(property "Design Note" "FITTED 0R LINK, deliberately not a DNP placeholder -- it sits in SERIES in the only supply path to the ring, so leaving it unpopulated would open the heater feed and the heater would never run at all. It reserves the position for a protective device against a fault path that is NEW: with RH1/RH2 sitting in the main-board branch and NOT in the fork feed, nothing limits the fork itself, so a short between the fork fingers -- which run at 0.20 mm clearance to a metal cell can, RING-PCB.md section 1 -- puts +12V_SW across Q2 unlimited, and possibly 12 V onto the cell. DO NOT FIT AS DRAWN: a PPTC is likely the wrong device here, because F1's own note records IH derating to 0.36 A at 85 C, and a part that holds the heater's 83 mA at pile temperature would nuisance-trip. The land exists so the option is not designed out; size it once the ring's resistance is fixed. A PPTC is likely the wrong device: F1's own note records IH derating to 0.36 A at 85 C for a 0.75 A part, so one holding the heater's 83 mA would nuisance-trip at pile temperature"
			(at 0 0 90)
			(layer "B.SilkS")
			(hide yes)
			(uuid "6be165c7-38cc-4f6c-bd74-314e41be185c")
			(effects
				(font
					(size 1.27 1.27)
					(thickness 0.15)
				)
				(justify mirror)
			)
		)
		(property "ki_keywords" "resettable fuse PTC PPTC polyfuse polyswitch"
			(at 0 0 90)
			(layer "B.SilkS")
			(hide yes)
			(uuid "94e98b9a-7819-4617-b61d-727aecd8c3db")
			(effects
				(font
					(size 1.27 1.27)
					(thickness 0.15)
				)
				(justify mirror)
			)
		)
		(property ki_fp_filters "*polyfuse* *PTC*")
