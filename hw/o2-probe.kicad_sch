		(dnp no)
		(uuid "60dfc9b3-e022-5072-a5ea-3e29c0e06217")
		(property "Reference" "U15" (at 231.14 66.04 0) (effects (font (size 1.0 1.0))))
		(property "Value" "REF3425IDBVR" (at 241.3 68.58 0) (effects (font (size 1.0 1.0)) (justify right)))
		(property "Footprint" "Package_TO_SOT_SMD:SOT-23-6" (at 236.22 76.2 0) (effects (font (size 1.27 1.27)) hide))
		(property "MPN" "REF3425IDBVR" (at 236.22 76.2 0) (effects (font (size 1.27 1.27)) hide))
		(property "Design Note" "2.500 V series reference, REPLACING the AZ431 shunt and its R41/C9/R31 network. SBAS804G: +/-0.05% initial accuracy (max), 6 ppm/C max by the BOX method over -40..125 C -- which permits 990 ppm of TOTAL SPAN, not a 6 ppm/C local slope, so the bias contribution is ~0.9 mV and NOT the 0.3 mV a naive reading gives. 95 uA max Iq against the AZ431 network's 2.5 mA. Output +/-10 mA against this board's ~400 uA analog draw. IT IS NOT A 3-TERMINAL PART: pins are 1 GND_F, 2 GND_S, 3 EN, 4 IN, 5 OUT_S, 6 OUT_F and force/sense must BOTH be connected. EN IS TIED TO IN ON PURPOSE. Do not route it to a GPIO to make the rail gateable -- POWER-BUDGET.md invites exactly that, and dropping this rail drops the cell bias and restarts O2P_SETTLE_SECONDS = 900. Input is 3V3D and NOT +12V_SW: the board input is specified to 15 V and REF34's recommended input maximum is 12 V" (at 236.22 76.2 0) (effects (font (size 1.27 1.27)) hide))
		(pin "4" (uuid "bc7c95c8-f8ae-52dc-a923-42f22ced6505"))
		(pin "6" (uuid "5119b7f1-c96d-52df-abef-f06499483147"))
