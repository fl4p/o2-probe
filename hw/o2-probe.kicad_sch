		(property "Reference" "J5" (at 363.22 185.42 0) (effects (font (size 1.0 1.0))))
		(property "Value" "HEATED MEMBRANE RING" (at 373.38 187.96 0) (effects (font (size 1.0 1.0)) (justify right)))
		(property "Footprint" "o2-probe:Heater_Ring_Lands" (at 368.3 195.58 0) (effects (font (size 1.27 1.27)) hide))
		(property "Design Note" "Manual-soldered dry-side metal membrane-carrier ring. TWO RING LANDS at the front edge, each present on FRONT AND BACK copper (Fab, 2026-09-13), 2.8 x 2.0 mm - no drills, no plated slots, no castellations: the ring is soldered flat, so none of that tooling bought anything. All four pads are number 1, i.e. ONE HEATER_LOW node, so the ring is a heat spreader and never a conductor. The back lands sit inside the HEATED_ISLAND_SPREADER pour, which is what connects them - no track is required, and one added in its place connected nothing; a via at each land ties the front land down to that pour. Width is 2x the first attempt; HEIGHT IS CAPPED AT 2.0 by /I2C_SDA reaching Y 136.45 under the left land, not by choice." (at 368.3 195.58 0) (effects (font (size 1.27 1.27)) hide))
		(pin "1" (uuid "bb18c145-b8a0-5c8b-ad5b-08817dbf3f6b"))
		(instances
			(project "o2-probe" (path "/b44d674b-6a5d-5766-ad6a-7746f68babf9" (reference "J5") (unit 1)))
		)
	)
