		(property "Reference" "R26" (at 160.02 160.02 0) (effects (font (size 1.0 1.0))))
		(property "Value" "91k 1%" (at 170.18 162.56 0) (effects (font (size 1.0 1.0)) (justify right)))
		(property "Footprint" "Resistor_SMD:R_0603_1608Metric" (at 165.1 167.64 0) (effects (font (size 1.27 1.27)) hide))
		(property "MPN" "RC0603FR-0791KL" (at 165.1 167.64 0) (effects (font (size 1.27 1.27)) hide))
		(property "Design Note" "VIN monitor divider, was 130k/20k, then 82k/10k. 91k is the SAME ORDERED LINE as R43/R44 and that is the only reason it is 91k rather than 82k -- either is adequate for a supply monitor. FIRMWARE: ratio is 10/101 = 0.0990, so 15V maps to 1.485V and 7V to 0.693V, both inside the 3.3V ADC, and source impedance is 9.0k. hw_contract.h is GENERATED from these values, so the firmware follows the change instead of silently rescaling" (at 165.1 167.64 0) (effects (font (size 1.27 1.27)) hide))
		(pin "1" (uuid "0cb0349d-174d-58ae-ae64-87ae9edd6277"))
