		(dnp no)
		(uuid "66d66e4b-ebfd-5d23-a953-f200cee39d66")
		(property "Reference" "C26" (at 83.82 65.278 0) (effects (font (size 1.0 1.0))))
		(property "Value" "100n" (at 93.98 67.818 0) (effects (font (size 1.0 1.0)) (justify right)))
		(property "Footprint" "Capacitor_SMD:C_0402_1005Metric" (at 88.9 71.12 0) (effects (font (size 1.27 1.27)) hide))
		(property "Design Note" "Local decoupling AT MCU VREF+ pin 5, which since 2026-09-12 is driven from /VREF_TRIM and not 3V3D. It FOLLOWED THE PIN rather than staying on 3V3D: its only reason to exist was that pin, and with pin 5 moved its bulk would otherwise be C10, 4.7 uF at U15 on the far side of the board. DS12232 Table 63 note 4 asks for a 100 nF specifically to cut high-frequency noise at this pin. 100n not 1u because the bulk is already at C10 and the total load on the REF3425 must stay inside SBAS804G's 0.1..10 uF stable range: 4.7 + 0.1 = 4.8 uF. 3V3D loses nothing -- C12, C13, C14, C11, C3, C20 and C21 are all still on it" (at 88.9 71.12 0) (effects (font (size 1.27 1.27)) hide))
		(pin "1" (uuid "a2d69603-14cb-5768-a618-23139007f0bb"))
		(pin "2" (uuid "a8b71cd5-474b-5345-ad4a-7b5f77830cd1"))
