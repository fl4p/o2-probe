	(symbol
		(lib_id "o2-probe:OPA2333")
		(at 246.38 35.56 0)
		(unit 1)
		(exclude_from_sim no)
		(in_bom yes)
		(on_board yes)
		(dnp no)
		(uuid "0a3dd837-016a-5219-a690-8c59a8f8cd0e")
		(property "Reference" "U4" (at 241.3 24.13 0) (effects (font (size 1.0 1.0))))
		(property "Value" "OPA2333AIDGKR" (at 251.46 26.67 0) (effects (font (size 1.0 1.0)) (justify right)))
		(property "Footprint" "Package_SO:VSSOP-8_3x3mm_P0.65mm" (at 246.38 35.56 0) (effects (font (size 1.27 1.27)) hide))
		(property "MPN" "OPA2333AIDGKR" (at 246.38 35.56 0) (effects (font (size 1.27 1.27)) hide))
		(property "Design Note" "Both halves are now unity-gain electrometer followers on the cell nodes: A buffers WE, B buffers RE and drives both the guard (through R40) and the ADC bias telemetry. Half A was freed by deleting the VREF trim divider. NO FEMTOAMPERE PART IS NEEDED HERE and this is the reason: SBOS351E gives OPA333 IB as +/-70 pA typ and +/-200 pA max at 25 C. MIND THE ARITHMETIC: IB is the AVERAGE of the two inputs, and a follower's electrode sees the non-inverting input alone, so the real bound is |IB| + |IOS|/2 = 200 + 200 = 400 pA. The RE node is ALREADY loaded by the LMP91000's own RE pin at +/-90 pA typ and +/-900 pA max over -40..80 C (SNAS506I IRE, TI's own front-page feature; at this board's 3.3 V the applicable column is nearer 800 pA). So half B takes RE's worst case from ~900 pA to ~1300 pA, +44%, and an ADA4530-1 at 20 fA would still leave ~900 pA and buy nothing. UNSTATED ASSUMPTION, flagged deliberately: SBOS351E gives NO max for IB over temperature, only +/-150 pA typ, so the claim that a chopper's charge-injection-dominated bias stays flat to 75 C rests on Figure 8, a typical curve, not a guaranteed limit. See POTTING.md section 1.3 under ../../../ha/farming/compostlab/o2-probe/" (at 246.38 35.56 0) (effects (font (size 1.27 1.27)) hide))
		(pin "1" (uuid "8ef63f60-fb0a-5a84-a38d-b1eb51f3de11"))
		(pin "2" (uuid "fb8f58a6-7a46-50cc-a69e-f5da50a9d1cc"))
