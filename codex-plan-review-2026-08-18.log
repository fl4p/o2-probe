  1002	@_mut("expose-hop", "bottom mask integrity", on_text=True)
  1003	def _expose_hop(txt):
  1004	    """Replace the notched apertures with one plain rectangle -- the pre-review
  1005	    geometry, which leaves the ADD0 hop's two vias bare on the contact face
  1006	    alongside the TPAD pour.  That is the short this exclusion exists to stop."""
  1007	    txt = _drop_blocks(txt, "\n\t(gr_rect", keep=lambda b: '(layer "B.Mask")' not in b)
  1008	    big = ('\n\t(gr_rect\n\t\t(start 100.4 100.4)\n\t\t(end 109.3 106.6)\n'
  1009	           '\t\t(stroke (width 0.05) (type solid))\n\t\t(fill solid)\n'
  1010	           '\t\t(layer "B.Mask")\n\t\t(uuid "00000000-0000-5000-a000-000000000001")\n\t)')
  1011	    return txt.replace("\n\t(segment", big + "\n\t(segment", 1)
