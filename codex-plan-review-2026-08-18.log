  1014	@_mut("widen-exemption", "mask-bridge scope", on_text=True)
  1015	def _widen_exemption(txt):
  1016	    """Give a second footprint the ganged-window exemption."""
  1017	    out, n = re.subn(r"\(attr smd\)", "(attr smd allow_soldermask_bridges)", txt, count=1)
  1018	    if n != 1:
  1019	        raise SystemExit("injection matched no plain '(attr smd)' footprint")
  1020	    return out
