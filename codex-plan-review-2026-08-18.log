   969	@_mut("fatten-neck", "island leak fraction")
   970	def _fatten_neck(b):
   971	    for t in b.Tracks():
   972	        if t.GetClass() != "PCB_TRACK":
   973	            continue
   974	        y1 = pcbnew.ToMM(t.GetStart().y - ORG.y)
   975	        y2 = pcbnew.ToMM(t.GetEnd().y - ORG.y)
   976	        if min(y1, y2) <= 8.5 <= max(y1, y2):
   977	            t.SetWidth(pcbnew.FromMM(1.5))
