  1116	
  1117	def calibrate():
  1118	    """Feed each guard the defect it exists to catch and watch it FAIL.
  1119	
  1120	    A guard never seen to fire is not a guard.
  1121	    """
  1122	    import subprocess
  1123	    silent = []
  1124	    for name, (_, expect, _t) in MUTATIONS.items():
  1125	        # --variant MUST be forwarded.  Without it the child audits the BASE
  1126	        # board while the parent's banner says otherwise, so every guard reads as
  1127	        # calibrated against a board that was never under test -- and the
  1128	        # variant-only injections fail with a KeyError, because they were never
  1129	        # registered in a process that thinks it is building the base.
  1130	        out = subprocess.run([sys.executable, __file__, "--variant", VKEY,
  1131	                              "--inject", name],
  1132	                             capture_output=True, text=True)
  1133	        got, saw = None, False
  1134	        for line in out.stdout.splitlines():
  1135	            if line.startswith("FAILS:"):
  1136	                got, saw = line[6:], True
  1137	        if not saw:
  1138	            # The injection process never reported. That is a broken harness, and
  1139	            # it must not be indistinguishable from a guard that did not fire.
  1140	            tail = (out.stdout + out.stderr).strip().splitlines()
  1141	            print(f"  BROKEN  {name:22s} -> injection produced no verdict: "
  1142	                  f"{tail[-1] if tail else '(no output)'}")
  1143	            silent.append(name)
  1144	            continue
  1145	        fired = expect in got.split(",")
  1146	        print(f"  {'FIRED ' if fired else 'SILENT'}  {name:22s} -> expected {expect!r}"
  1147	              + ("" if fired else f"; guards that fired: {got or '(none)'}"))
  1148	        if not fired:
  1149	            silent.append(name)
  1150	    return silent
  1151	
  1152	
  1153	def main():
  1154	    if "--inject" in sys.argv:
  1155	        run_injected(sys.argv[sys.argv.index("--inject") + 1])
  1156	        return 0
  1157	    if not BOARD.exists():
  1158	        sys.exit(f"{BOARD.name} not found -- run gen_pcb.py first")
  1159	    board = pcbnew.LoadBoard(str(BOARD))
  1160	    print(f"audit of {BOARD.name}")
  1161	    fails = Audit(board).run()
  1162	
  1163	    if "--calibrate" in sys.argv:
  1164	        print("\ncalibration -- each guard fed the defect it exists to catch:")
  1165	        silent = calibrate()
  1166	        if silent:
  1167	            sys.exit(f"\nguards that did NOT fire on their own defect: {silent}")
  1168	        print("\nall guards fired on their calibration input")
  1169	
  1170	    if fails:
  1171	        sys.exit(f"\naudit FAILED: {fails}")
  1172	    print("\naudit passed")
  1173	    return 0
  1174	
  1175	
  1176	if __name__ == "__main__":
  1177	    sys.exit(main())
     1	#!/usr/bin/env python3
     2	"""Own the design settings in tmp117-probe.kicad_pro.
     3	
     4	WHY THIS FILE EXISTS.  `pcbnew.LoadBoard()` / `BOARD.Save()` rewrite the
     5	adjacent .kicad_pro wholesale from KiCad's in-memory defaults.  On the first run
     6	of gen_pcb.py that silently replaced every value below -- min_clearance 0.15 ->
     7	0.0, min_track_width 0.15 -> 0.0, the TPAD net class deleted outright, and five
     8	DRC rules flipped to "ignore":
     9	
    10	    footprint_filters_mismatch, footprint_type_mismatch, missing_courtyard,
    11	    npth_inside_courtyard, pth_inside_courtyard
    12	
    13	A DRC run after that reports "0 violations" while being unable to see any of
    14	them.  It is the guard-precondition-moves-silently failure, and checking the
    15	file BEFORE the board is built does not catch it -- the clobber happens after.
    16	
    17	So: KiCad's own writer produces the schema-correct file, and this module patches
    18	our values back on top of it, idempotently, AFTER every pcbnew save.  `verify()`
    19	then re-reads from disk and fails the build if anything did not stick.  Never
    20	assert on the copy you wrote from memory; assert on the file.
    21	"""
    22	
    23	import json
    24	import pathlib
    25	import sys
    26	
    27	HERE = pathlib.Path(__file__).resolve().parent
    28	
    29	# Every variant gets the same settings: the rules below are process and design
    30	# minimums, and a variant that differs only in its outline has no business
    31	# relaxing any of them.  The path is a parameter so the two projects cannot
    32	# share -- or clobber -- one another's file.
    33	import variants   # noqa: E402
    34	
    35	
    36	def prj_path(variant_key="base"):
    37	    return HERE / f"{variants.VARIANTS[variant_key]['name']}.kicad_pro"
    38	
    39	# --------------------------------------------------------------------------- our values
    40	#
    41	# Fab: JLCPCB 2-layer, 1 oz outer.  Their process minimums are 0.0889 mm track
    42	# and space and 0.2 mm copper-to-edge; the figures below are the DESIGN minimums
    43	# and sit above the process ones on purpose, so a marginal feature shows up as a
    44	# DRC violation here rather than as a yield problem there.
    45	RULES = {
    46	    "min_clearance": 0.15,
    47	    "min_track_width": 0.15,
    48	    "min_copper_edge_clearance": 0.25,
    49	    "min_silk_clearance": 0.15,
    50	    "min_hole_clearance": 0.25,
    51	    "min_hole_to_hole": 0.25,
    52	    "min_through_hole_diameter": 0.3,
    53	    "min_via_diameter": 0.55,
    54	    "min_via_annular_width": 0.125,
    55	    "min_text_height": 0.8,
    56	    "min_text_thickness": 0.15,
    57	    "min_resolved_spokes": 2,
    58	}
    59	
    60	# Rules that must be able to fire.  "ignore" anywhere makes a green DRC a
    61	# statement about this map rather than about the board.
    62	SEVERITY = {
    63	    "footprint_filters_mismatch": "error",
    64	    "footprint_type_mismatch": "error",
    65	    "missing_courtyard": "error",
    66	    "npth_inside_courtyard": "error",
    67	    "pth_inside_courtyard": "error",
    68	    "text_height": "error",
    69	    "text_thickness": "error",
    70	    "starved_thermal": "error",
    71	    "solder_mask_bridge": "error",
    72	    "shorting_items": "error",
    73	    "unconnected_items": "error",
    74	    "clearance": "error",
    75	    "copper_edge_clearance": "error",
    76	    "track_width": "error",
    77	}
    78	
    79	# The exposed-pad island floats at whatever the shunt sits at if the user's
    80	# insulating thermal interface fails.  0.25 mm is not an isolation rating and is
    81	# not claimed as one -- see DESIGN.md.  It is set equal to the smallest gap the
    82	# TMP117 package itself permits (EP land to terminal land), because a floor
    83	# above a figure the geometry cannot achieve is a floor that would have to be
    84	# waived on the very part it exists to protect.
    85	TPAD_CLASS = {
    86	    "bus_width": 12.0,
    87	    "clearance": 0.25,
    88	    "diff_pair_gap": 0.25,
    89	    "diff_pair_via_gap": 0.25,
    90	    "diff_pair_width": 0.2,
    91	    "line_style": 0,
    92	    "microvia_diameter": 0.3,
    93	    "microvia_drill": 0.1,
    94	    "name": "TPAD",
    95	    "pcb_color": "rgba(0, 0, 0, 0.000)",
    96	    "priority": 0,
    97	    "schematic_color": "rgba(0, 0, 0, 0.000)",
    98	    "track_width": 0.5,
    99	    "via_diameter": 0.6,
   100	    "via_drill": 0.3,
   101	    "wire_width": 6.0,
   102	}
   103	
   104	DEFAULT_CLASS = {"clearance": 0.15, "track_width": 0.2, "via_diameter": 0.6, "via_drill": 0.3}
   105	
   106	TRACK_WIDTHS = [0.0, 0.15, 0.25, 0.5]
   107	VIA_DIMENSIONS = [{"diameter": 0.0, "drill": 0.0}, {"diameter": 0.6, "drill": 0.3}]
   108	
   109	
   110	def apply(prj):
   111	    prj = pathlib.Path(prj)
   112	    d = json.loads(prj.read_text())
   113	    ds = d.setdefault("board", {}).setdefault("design_settings", {})
   114	    ds.setdefault("rules", {}).update(RULES)
   115	    ds.setdefault("rule_severities", {}).update(SEVERITY)
   116	    ds["track_widths"] = list(TRACK_WIDTHS)
   117	    ds["via_dimensions"] = [dict(v) for v in VIA_DIMENSIONS]
   118	
   119	    ns = d.setdefault("net_settings", {})
   120	    classes = ns.setdefault("classes", [])
   121	    by_name = {c.get("name"): c for c in classes}
   122	    if "Default" in by_name:
   123	        by_name["Default"].update(DEFAULT_CLASS)
   124	    if "TPAD" in by_name:
   125	        by_name["TPAD"].update(TPAD_CLASS)
   126	    else:
   127	        classes.append(dict(TPAD_CLASS))
   128	    ns["netclass_patterns"] = [{"netclass": "TPAD", "pattern": "/TPAD"}]
   129	
   130	    prj.write_text(json.dumps(d, indent=2, sort_keys=True) + "\n")
   131	
   132	
   133	def verify(prj):
   134	    """Re-read from DISK and check every value stuck.  Returns a summary line.
   135	
   136	    Deliberately reloads rather than trusting the dict apply() just wrote: the
   137	    whole point is that something else rewrites this file behind our back.
   138	    """
   139	    prj = pathlib.Path(prj)
   140	    d = json.loads(prj.read_text())
   141	    ds = d["board"]["design_settings"]
   142	    bad = []
   143	    for k, v in RULES.items():
   144	        if ds["rules"].get(k) != v:
   145	            bad.append(f"rules.{k} = {ds['rules'].get(k)!r}, want {v!r}")
   146	    sev = ds["rule_severities"]
   147	    for k, v in SEVERITY.items():
   148	        if sev.get(k) != v:
   149	            bad.append(f"severity.{k} = {sev.get(k)!r}, want {v!r}")
   150	    ignored = sorted(k for k, val in sev.items() if val == "ignore")
   151	    if ignored:
   152	        bad.append(f"rules at 'ignore', invisible to DRC: {ignored}")
   153	    names = [c.get("name") for c in d["net_settings"]["classes"]]
   154	    if "TPAD" not in names:
   155	        bad.append(f"TPAD net class missing (classes: {names})")
   156	    else:
   157	        tp = next(c for c in d["net_settings"]["classes"] if c["name"] == "TPAD")
   158	        if tp.get("clearance") != TPAD_CLASS["clearance"]:
   159	            bad.append(f"TPAD clearance = {tp.get('clearance')!r}")
   160	    if d["net_settings"].get("netclass_patterns") != [{"netclass": "TPAD", "pattern": "/TPAD"}]:
   161	        bad.append("TPAD netclass pattern missing -- the class would apply to nothing")
   162	    if bad:
   163	        raise SystemExit(f"{prj.name} settings did not stick:\n  " + "\n  ".join(bad))
   164	    return (f"{len(RULES)} rules, {len(sev)} severities (0 ignored), "
   165	            f"net classes {names}")
   166	
   167	
   168	if __name__ == "__main__":
   169	    key, _ = variants.select()
   170	    apply(prj_path(key))
   171	    print(verify(prj_path(key)))
   172	    sys.exit(0)

