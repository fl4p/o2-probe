   901	def _mut(name, expect, on_text=False):
   902	    """Register a defect injection.  `on_text` edits the saved .kicad_pcb instead
   903	    of going through pcbnew, because BOARD.Remove() invalidates SWIG's proxy for
   904	    the board -- the removal appears to work and then Save() writes the ORIGINAL.
   905	    That produced three guards reporting SILENT with "(none) fired", which is the
   906	    signature of a harness that did not run, not of a guard that missed."""
   907	    def deco(fn):
   908	        MUTATIONS[name] = (fn, expect, on_text)
   909	        return fn
   910	    return deco
   911	
   912	
   913	def _sexp(text, start):
   914	    depth, i, in_str, esc = 0, start, False, False
   915	    while i < len(text):
   916	        c = text[i]
   917	        if in_str:
   918	            if esc:
   919	                esc = False
   920	            elif c == "\\":
   921	                esc = True
   922	            elif c == '"':
   923	                in_str = False
   924	        else:
   925	            if c == '"':
   926	                in_str = True
   927	            elif c == "(":
   928	                depth += 1
   929	            elif c == ")":
   930	                depth -= 1
   931	                if depth == 0:
   932	                    return text[start:i + 1]
   933	        i += 1
   934	    raise ValueError("unbalanced s-expression")
   935	
   936	
   937	def _drop_blocks(text, opener, keep=lambda b: False):
   938	    """Delete every balanced block starting with `opener` unless keep(block)."""
   939	    import re as _re
   940	    out, pos, n = [], 0, 0
   941	    for m in _re.finditer(_re.escape(opener), text):
   942	        if m.start() < pos:
   943	            continue
   944	        start = text.index("(", m.start())
   945	        blk = _sexp(text, start)
   946	        if keep(blk):
   947	            continue
   948	        out.append(text[pos:start])
   949	        pos = start + len(blk)
   950	        n += 1
   951	    out.append(text[pos:])
   952	    if n == 0:
   953	        raise SystemExit(f"injection matched no {opener!r} blocks -- the injection "
   954	                         f"itself is broken, which would read as a guard that missed")
   955	    return "".join(out)
   956	
   957	
   958	@_mut("kill-vias", "EP -> island", on_text=True)
   959	def _kill_vias(txt):
   960	    return _drop_blocks(txt, "\n\t(via")
