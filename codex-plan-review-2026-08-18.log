  1034	if MOUNT:
  1035	    @_mut("move-hole", "M3 keep-out")
  1036	    def _move_hole(b):
  1037	        """Slide the M3 hole south until its head sits over the thermal copper.
  1038	
  1039	        This is the realistic version of the defect: nobody deletes the keep-out,
  1040	        they nudge the hole to shorten the board and the screw ends up bearing on
  1041	        the island."""
  1042	        dy = pcbnew.FromMM(2.5)
  1043	        n = 0
  1044	        for fp in b.Footprints():
  1045	            if fp.GetReference() == MOUNT["ref"]:
  1046	                p = fp.GetPosition()
  1047	                fp.SetPosition(pcbnew.VECTOR2I(p.x, p.y + dy))
  1048	                n += 1
  1049	        if n != 1:
  1050	            raise SystemExit(f"move-hole found {n} mounting holes -- injection broken")
  1051	
  1052	    @_mut("shrink-tab", "M3 head seat")
  1053	    def _shrink_tab(b):
  1054	        """Trim the tab back to just clear the drill, leaving the head overhanging."""
  1055	        y0 = ORG.y + pcbnew.FromMM(Y_TOP)
  1056	        y1 = ORG.y + pcbnew.FromMM(MOUNT["xy"][1] - MOUNT["drill"] / 2.0 - 0.10)
  1057	        n = 0
  1058	        for d in b.GetDrawings():
  1059	            if d.GetLayer() != pcbnew.Edge_Cuts:
  1060	                continue
  1061	            for get, put in ((d.GetStart, d.SetStart), (d.GetEnd, d.SetEnd)):
  1062	                p = get()
  1063	                if p.y == y0:
  1064	                    put(pcbnew.VECTOR2I(p.x, y1))
  1065	                    n += 1
  1066	        if n == 0:
  1067	            raise SystemExit("shrink-tab moved no north edge -- injection broken")
  1068	
  1069	    @_mut("drop-hole", "M3 hole", on_text=True)
  1070	    def _drop_hole(txt):
  1071	        return _drop_blocks(txt, '\n\t(footprint "MountingHole')
  1072	else:
  1073	    @_mut("add-stray-hole", "M3 hole")
  1074	    def _add_stray_hole(b):
  1075	        """A mounting hole appearing on the variant that must not have one.
  1076	
  1077	        The base board is held by compound alone; a hole drilled through the
  1078	        contact island would vent it under clamping load.  Without this the
  1079	        `M3 hole` check would only ever be exercised on the m3 variant, and its
  1080	        zero-holes branch would be a line of code nobody had watched fail."""
  1081	        fp = pcbnew.FootprintLoad(str(KI_FP / "MountingHole.pretty"),
  1082	                                  "MountingHole_3.2mm_M3")
  1083	        if fp is None:
  1084	            raise SystemExit("add-stray-hole could not load the footprint -- broken")
  1085	        b.Add(fp)
  1086	        fp.SetReference("H9")
  1087	        fp.SetPosition(pcbnew.VECTOR2I(ORG.x + pcbnew.FromMM(4.5),
  1088	                                       ORG.y + pcbnew.FromMM(12.5)))
