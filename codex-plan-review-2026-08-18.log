  1091	def run_injected(name):
  1092	    """Apply one injection to a copy of the board and print which guards failed.
  1093	
  1094	    Runs in its own process (see calibrate): repeated pcbnew.LoadBoard() calls in
  1095	    one interpreter stop downcasting the returned BOARD, and every check then
  1096	    dies on a SwigPyObject -- which would look like a broken guard rather than a
  1097	    broken harness.
  1098	    """
  1099	    import shutil
  1100	    import tempfile
  1101	    fn, _, on_text = MUTATIONS[name]
  1102	    td = tempfile.mkdtemp()
  1103	    tmp = pathlib.Path(td) / "t.kicad_pcb"
  1104	    shutil.copy(BOARD, tmp)
  1105	    if on_text:
  1106	        tmp.write_text(fn(tmp.read_text()))
  1107	    else:
  1108	        b = pcbnew.LoadBoard(str(tmp))
  1109	        fn(b)
  1110	        b.Save(str(tmp))
  1111	    b = pcbnew.LoadBoard(str(tmp))
  1112	    a = Audit(b)
  1113	    fails = a.run_quiet()
  1114	    print("FAILS:" + ",".join(fails))
