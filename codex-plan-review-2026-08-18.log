  1023	@_mut("cut-decoupling", "decoupling leg VDD", on_text=True)
  1024	def _cut_decoupling(txt):
  1025	    import re as _re
  1026	    m = _re.search(r'\(net (\d+) "VDD"\)', txt)
  1027	    if not m:
  1028	        raise SystemExit("no VDD net in the board -- injection cannot run")
  1029	    n = m.group(1)
  1030	    return _drop_blocks(txt, "\n\t(segment",
  1031	                        keep=lambda b: f"(net {n})" not in b)
