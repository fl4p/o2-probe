   880	        self.thermal_vias()
   881	        self.contact_area()
   882	        self.neck_conductance()
   883	        self.die_coupling()
   884	        self.decoupling_loop()
   885	        self.via_in_paste_pad()
   886	        self.bottom_mask_integrity()
   887	        self.mask_bridge_scope()
   888	        self.stackup_present()
   889	        self.mounting_hardware()
   890	        self.mount_keepout()
   891	        self.mount_head_seat()
